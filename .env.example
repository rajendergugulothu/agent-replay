# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=

# Model for the planner agent (small, cheap) and for the LLM judge (stronger).
# There is no default: the experiment records exactly which models ran.
OPENAI_MODEL=
JUDGE_MODEL=

DATABASE_PATH=data/agent_replay.db

# Limits on one run, on one model reply, and on a whole day of live use.
MAX_TOKENS_PER_RUN=40000
MAX_STEPS_PER_RUN=15
MAX_COMPLETION_TOKENS=4000
DAILY_TOKEN_LIMIT=2000000

# Leave AGENT_TEMPERATURE empty to use the model's default.
# Some models reject a temperature setting. If the judge call fails for that
# reason, leave JUDGE_TEMPERATURE empty too. The value sent is stored either way.
AGENT_TEMPERATURE=
JUDGE_TEMPERATURE=0

# Demo mode: only the listed scenarios can be started from the UI.
DEMO_MODE=0
DEMO_SCENARIOS=

# 1 = run from recorded responses in demo/recordings with no network.
OFFLINE=0

# Used only by "make preflight".
PRODUCTION_URL=
