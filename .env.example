# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Model for the planner agent (small, cheap) and for the LLM judge (stronger).
OPENAI_MODEL=
JUDGE_MODEL=
DATABASE_PATH=data/agent_replay.db
MAX_TOKENS_PER_RUN=40000
MAX_STEPS_PER_RUN=15
DAILY_TOKEN_LIMIT=2000000
# Optional. Leave empty to use the model's default temperature.
AGENT_TEMPERATURE=
JUDGE_TEMPERATURE=0
DEMO_MODE=0
OFFLINE=0
